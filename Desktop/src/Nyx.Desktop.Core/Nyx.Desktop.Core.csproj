<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AchievementGiCatalogPath>$(MSBuildThisFileDirectory)../../../contracts/achievements-gi-catalog.json</AchievementGiCatalogPath>
    <AchievementHsrCatalogPath>$(MSBuildThisFileDirectory)../../../contracts/achievements-hsr-catalog.json</AchievementHsrCatalogPath>
  </PropertyGroup>

  <UsingTask TaskName="GenerateAchievementCatalogVersions"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <GiCatalog ParameterType="System.String" Required="true" />
      <HsrCatalog ParameterType="System.String" Required="true" />
      <OutputFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Reference Include="$(MSBuildToolsPath)/Sdks/Microsoft.NET.Sdk/tools/net472/System.Text.Json.dll" />
      <Reference Include="$(MSBuildToolsPath)/Sdks/Microsoft.NET.Sdk/tools/net472/System.Memory.dll" />
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Text.Json" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        Func<string, string, string> readVersion = (path, expectedGame) =>
        {
            using var document = JsonDocument.Parse(File.ReadAllBytes(path));
            if (document.RootElement.ValueKind != JsonValueKind.Object)
                throw new InvalidDataException($"{path} must contain a JSON object.");

            string requiredString(string name)
            {
                var matches = document.RootElement.EnumerateObject()
                    .Where(property => property.NameEquals(name))
                    .ToArray();
                if (matches.Length != 1 || matches[0].Value.ValueKind != JsonValueKind.String)
                    throw new InvalidDataException($"{path} must contain exactly one string {name}.");
                return matches[0].Value.GetString()!;
            }

            var game = requiredString("game");
            var version = requiredString("catalogVersion");
            var releasedVersion = requiredString("releasedVersion");
            if (!String.Equals(game, expectedGame, StringComparison.Ordinal)
                || !Regex.IsMatch(version, @"^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$", RegexOptions.CultureInvariant)
                || !String.Equals(releasedVersion, version, StringComparison.Ordinal))
                throw new InvalidDataException($"{path} has an invalid game/catalogVersion/releasedVersion shape.");
            return expectedGame + "-" + version;
        };

        try
        {
            var genshin = readVersion(GiCatalog, "gi");
            var starRail = readVersion(HsrCatalog, "hsr");
            Directory.CreateDirectory(Path.GetDirectoryName(Path.GetFullPath(OutputFile))!);
            var source = "// <auto-generated />\nnamespace Nyx.Desktop.Core.Exports;\n\n"
                + "public static partial class AchievementCatalogVersions\n{\n"
                + $"    public const string Genshin = \"{genshin}\";\n"
                + $"    public const string StarRail = \"{starRail}\";\n"
                + "}\n";
            var bytes = new UTF8Encoding(false).GetBytes(source);
            if (!File.Exists(OutputFile) || !File.ReadAllBytes(OutputFile).SequenceEqual(bytes))
                File.WriteAllBytes(OutputFile, bytes);
        }
        catch (Exception error)
        {
            Log.LogErrorFromException(error, showStackTrace: false);
            return false;
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="GenerateAchievementCatalogVersions" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <AchievementCatalogVersionsSource Condition="'$(AchievementCatalogVersionsSource)' == ''">$(IntermediateOutputPath)AchievementCatalogVersions.g.cs</AchievementCatalogVersionsSource>
    </PropertyGroup>
    <GenerateAchievementCatalogVersions GiCatalog="$(AchievementGiCatalogPath)"
                                        HsrCatalog="$(AchievementHsrCatalogPath)"
                                        OutputFile="$(AchievementCatalogVersionsSource)" />
    <ItemGroup>
      <Compile Include="$(AchievementCatalogVersionsSource)" />
    </ItemGroup>
  </Target>

</Project>
