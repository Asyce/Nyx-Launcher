<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Nyx_Desktop_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource VoidBrush}"
    mc:Ignorable="d">

    <Grid x:Name="RootShell" Background="{ThemeResource VoidBrush}">
        <Image
            x:Name="BackgroundArtwork"
            IsHitTestVisible="False"
            Opacity="{ThemeResource DecorativeArtOpacity}"
            Stretch="UniformToFill"
            AutomationProperties.AccessibilityView="Raw" />

        <Image
            x:Name="BackgroundArtworkNext"
            IsHitTestVisible="False"
            Opacity="0"
            Stretch="UniformToFill"
            AutomationProperties.AccessibilityView="Raw" />

        <MediaPlayerElement
            x:Name="LauncherMotionBackground"
            AreTransportControlsEnabled="False"
            AutoPlay="True"
            IsHitTestVisible="False"
            Opacity="0"
            Stretch="UniformToFill"
            AutomationProperties.AccessibilityView="Raw" />

        <MediaPlayerElement
            x:Name="LauncherMotionBackgroundNext"
            AreTransportControlsEnabled="False"
            AutoPlay="True"
            IsHitTestVisible="False"
            Opacity="0"
            Stretch="UniformToFill"
            AutomationProperties.AccessibilityView="Raw" />

        <Rectangle
            x:Name="HighContrastBackdrop"
            IsHitTestVisible="False"
            Fill="{ThemeResource HighContrastBackdropBrush}"
            Opacity="{ThemeResource HighContrastBackdropOpacity}"
            AutomationProperties.AccessibilityView="Raw" />

        <Grid x:Name="LayoutGrid" Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="RailRow" Height="0" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="RailColumn" Width="132" />
                <ColumnDefinition x:Name="ContentColumn" Width="620" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="RailSurface"
                Grid.RowSpan="2"
                Grid.Column="0"
                BorderBrush="{ThemeResource HairlineBrush}"
                BorderThickness="0,0,1,0"
                Background="{ThemeResource RailSurfaceBrush}"
                PointerEntered="RailSurface_PointerEntered"
                PointerExited="RailSurface_PointerExited">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="RailBrandRow" Height="104" />
                        <RowDefinition x:Name="RailContentRow" Height="Auto" />
                        <RowDefinition x:Name="RailAddRow" Height="Auto" />
                        <RowDefinition x:Name="RailSpacerRow" Height="*" />
                        <RowDefinition x:Name="RailFooterRow" Height="66" />
                    </Grid.RowDefinitions>

                    <Grid
                        Width="124"
                        Height="104"
                        Margin="4,0,4,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top">
                    <Button
                        x:Name="BrandLockup"
                        Padding="0"
                        AutomationProperties.Name="Open the Nyx website"
                        Click="BrandLockup_Click"
                        Style="{StaticResource NyxBrandButtonStyle}" />
                        <Grid
                            x:Name="BrandLogo"
                            Width="120"
                            Height="96"
                            Margin="0,3,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            IsHitTestVisible="False"
                            AutomationProperties.Name="Nyx logo"
                            AutomationProperties.AccessibilityView="Raw">
                            <Image
                                x:Name="BrandEyeBall"
                                Source="ms-appx:///Assets/Brand/eye_ball.png"
                                Stretch="Uniform">
                                <Image.RenderTransform>
                                    <TranslateTransform x:Name="BrandEyeBallTranslate" />
                                </Image.RenderTransform>
                            </Image>
                            <Image
                                Source="ms-appx:///Assets/Brand/eye_lid.png"
                                Stretch="Uniform" />
                            <Image
                                Source="ms-appx:///Assets/Brand/eye_drips.png"
                                Stretch="Uniform" />
                        </Grid>
                    </Grid>

                    <ListView
                        x:Name="GameSelector"
                        Grid.Row="1"
                        Width="132"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="Games"
                        ContainerContentChanging="GameSelector_ContainerContentChanging"
                        CanDragItems="True"
                        CanReorderItems="True"
                        AllowDrop="True"
                        ReorderMode="Enabled"
                        DragItemsCompleted="GameSelector_DragItemsCompleted"
                        IsItemClickEnabled="True"
                        ItemContainerStyle="{StaticResource NyxGameItemStyle}"
                        ItemsSource="{x:Bind Games}"
                        SelectedIndex="0"
                        SelectionMode="Single"
                        ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                        ScrollViewer.HorizontalScrollMode="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollMode="Enabled">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid
                                    x:Name="GameRailItemLayout"
                                    Width="{Binding ItemExtent}"
                                    Height="{Binding ItemExtent}"
                                    AutomationProperties.Name="{Binding AccessibilityName}">
                                    <Border
                                        x:Name="GameRailItemBacking"
                                        Background="Transparent"
                                        CornerRadius="8"
                                        IsHitTestVisible="False" />
                                    <Image
                                        x:Name="GameRailItemIcon"
                                        Width="{Binding IconSize}"
                                        Height="{Binding IconSize}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Source="{Binding IconPath}"
                                        Stretch="Uniform"
                                        AutomationProperties.Name="{Binding DisplayName}"
                                        AutomationProperties.AccessibilityView="Raw" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Button
                        x:Name="AddGameButton"
                        Grid.Row="2"
                        Width="96"
                        Height="96"
                        Margin="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Opacity="0.08"
                        AutomationProperties.Name="Add a custom game"
                        Click="AddGameButton_Click"
                        GotFocus="AddGameButton_GotFocus"
                        LostFocus="AddGameButton_LostFocus"
                        Style="{StaticResource NyxRailActionStyle}">
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            FontSize="36"
                            Glyph="&#xE710;" />
                    </Button>

                    <Button
                        x:Name="KofiButton"
                        Grid.Row="4"
                        Width="110"
                        Height="38"
                        Margin="10,0,10,6"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        AutomationProperties.Name="Support Pengo on Ko-fi"
                        Click="KofiButton_Click"
                        Style="{StaticResource NyxBrandButtonStyle}">
                        <Image
                            Width="90"
                            MaxHeight="29"
                            Source="ms-appx:///Assets/Brand/kofi-logo.png"
                            Stretch="Uniform" />
                    </Button>
                </Grid>
            </Border>

            <Grid
                x:Name="BannerContentRegion"
                Grid.RowSpan="2"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                Margin="26,38,18,292"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">
                <StackPanel x:Name="ContentPanel" MaxWidth="704" Spacing="0">
                    <Border
                        x:Name="BannerCycleRegion"
                        Padding="0"
                        AutomationProperties.Name="Current and next character banners"
                        Background="{ThemeResource LauncherInfoSurfaceBrush}"
                        BorderBrush="{ThemeResource DeckBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <Grid
                            x:Name="BannerCycleStack"
                            RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel
                                x:Name="BannerCycleHeader"
                                HorizontalAlignment="Stretch"
                                Margin="12,8,12,0"
                                Spacing="5">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                    x:Name="BannerCycleHeading"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource NyxEyebrowTextStyle}"
                                    Foreground="{ThemeResource IrisBrush}"
                                    FontSize="18"
                                    Text="BANNERS" />
                                    <Button
                                        x:Name="BannerCollapseButton"
                                        Grid.Column="1"
                                        Width="28"
                                        Height="28"
                                        MinWidth="28"
                                        MinHeight="28"
                                        Padding="0"
                                        AutomationProperties.Name="Collapse Banners"
                                        Click="SectionCollapseButton_Click"
                                        Content="&#xE70D;"
                                        FontFamily="Segoe Fluent Icons"
                                        Style="{StaticResource NyxQuietActionStyle}"
                                        Tag="banners"
                                        ToolTipService.ToolTip="Collapse Banners" />
                                </Grid>
                                <Border
                                    x:Name="BannerCycleHeaderDivider"
                                    Height="1"
                                    Background="{ThemeResource HairlineBrush}"
                                    IsHitTestVisible="False" />
                            </StackPanel>

                            <Grid Grid.Row="1">
                                <Grid
                                    x:Name="BannerCycleColumns"
                                    Margin="14,0,14,10"
                                    RowSpacing="3">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                <Border
                                    x:Name="CurrentBannerSection"
                                    Margin="4,0,0,0"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="0">
                                    <Grid RowSpacing="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock
                                            x:Name="BannerCycleTiming"
                                            Margin="0,0,0,2"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource NyxDataFont}"
                                            FontSize="17"
                                            FontWeight="Bold"
                                            Foreground="{ThemeResource IrisBrush}" />
                                        <ItemsControl
                                            x:Name="BannerCharacterList"
                                            Grid.Row="1"
                                            HorizontalContentAlignment="Stretch"
                                            AutomationProperties.Name="Current banner characters"
                                            ItemsSource="{x:Bind BannerCharacterRows, Mode=OneWay}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Vertical" Spacing="3" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ItemsControl
                                                        HorizontalContentAlignment="Left"
                                                        ItemsSource="{Binding}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" Spacing="2" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid
                                                                    Width="132"
                                                                    MinHeight="38"
                                                                    Margin="0,0,0,2"
                                                                    HorizontalAlignment="Left"
                                                                    ColumnSpacing="4"
                                                                    Opacity="{Binding RowOpacity}">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="38" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border
                                                                        x:Name="CurrentBannerPortraitBacking"
                                                                        Width="38"
                                                                        Height="38"
                                                                        Background="{ThemeResource QuietSurfaceBrush}"
                                                                        BorderBrush="{ThemeResource IrisBrush}"
                                                                        BorderThickness="{Binding ActiveBorderThickness}"
                                                                        CornerRadius="19"
                                                                        IsHitTestVisible="False"
                                                                        Visibility="{Binding PrimaryVisibility}" />
                                                                    <Border
                                                                        x:Name="CurrentBannerPortrait"
                                                                        Width="34"
                                                                        Height="34"
                                                                        CornerRadius="17"
                                                                        IsHitTestVisible="False"
                                                                        AutomationProperties.Name="{Binding Name}"
                                                                        Visibility="{Binding PrimaryVisibility}">
                                                                        <Image
                                                                            Source="{Binding PortraitSource}"
                                                                            Stretch="UniformToFill" />
                                                                    </Border>
                                                                    <TextBlock
                                                                        x:Name="CurrentBannerNameLabel"
                                                                        Grid.Column="1"
                                                                        Margin="2,0"
                                                                        VerticalAlignment="Center"
                                                                        FontFamily="{StaticResource NyxBodyFont}"
                                                                        FontSize="15"
                                                                        Foreground="{ThemeResource MoonBrush}"
                                                                        IsHitTestVisible="False"
                                                                        Text="{Binding Name}"
                                                                        TextWrapping="Wrap"
                                                                        ToolTipService.ToolTip="{Binding Name}"
                                                                        Visibility="{Binding PrimaryVisibility}" />
                                                                    <Button
                                                                        x:Name="CurrentBannerNameButton"
                                                                        Grid.Column="1"
                                                                        Margin="0"
                                                                        Padding="0"
                                                                        HorizontalAlignment="Stretch"
                                                                        VerticalAlignment="Stretch"
                                                                        AutomationProperties.Name="{Binding CharacterLinkAccessibilityName}"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Click="CharacterLink_Click"
                                                                        CommandParameter="{Binding CharacterUrl}"
                                                                        IsEnabled="{Binding CanOpen}"
                                                                        Style="{StaticResource NyxCodeCopyButtonStyle}"
                                                                        Tag="{Binding Name}"
                                                                        ToolTipService.ToolTip="{Binding Name}"
                                                                        Visibility="{Binding PrimaryVisibility}" />
                                                                    <ItemsControl
                                                                        x:Name="CurrentBannerOverflowPortraits"
                                                                        Grid.ColumnSpan="2"
                                                                        HorizontalAlignment="Left"
                                                                        ItemsSource="{Binding OverflowPortraits}"
                                                                        Visibility="{Binding OverflowVisibility}">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <StackPanel Orientation="Horizontal" Spacing="6" />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Border
                                                                                    Width="30"
                                                                                    Height="30"
                                                                                    Background="{ThemeResource QuietSurfaceBrush}"
                                                                                    BorderBrush="{ThemeResource IrisBrush}"
                                                                                    BorderThickness="2"
                                                                                    CornerRadius="15"
                                                                                    AutomationProperties.Name="{Binding Name}"
                                                                                    ToolTipService.ToolTip="{Binding Name}">
                                                                                    <Image
                                                                                        Source="{Binding PortraitSource}"
                                                                                        Stretch="UniformToFill" />
                                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>

                                <ItemsControl
                                    x:Name="UpcomingBannerList"
                                    Grid.Row="1"
                                    Margin="4,0,0,0"
                                    HorizontalContentAlignment="Stretch"
                                    AutomationProperties.Name="Upcoming banner groups"
                                    ItemsSource="{x:Bind UpcomingBannerGroups, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Vertical" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid
                                                x:Name="UpcomingBannerPhaseSlot"
                                                Margin="0,0,0,2"
                                                RowSpacing="1">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock
                                                    x:Name="UpcomingBannerTiming"
                                                    Margin="0,1,0,0"
                                                    FontFamily="{StaticResource NyxDataFont}"
                                                    FontSize="15"
                                                    FontWeight="Bold"
                                                    Foreground="{ThemeResource IrisBrush}"
                                                    Text="{Binding Timing}" />
                                                    <ItemsControl
                                                        Grid.Row="1"
                                                        HorizontalContentAlignment="Left"
                                                        ItemsSource="{Binding CharacterRows}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Vertical" Spacing="3" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <ItemsControl
                                                                    HorizontalContentAlignment="Left"
                                                                    ItemsSource="{Binding}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <StackPanel Orientation="Horizontal" Spacing="2" />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Grid
                                                                                Width="132"
                                                                                MinHeight="38"
                                                                                Margin="0,0,0,2"
                                                                                HorizontalAlignment="Left"
                                                                                ColumnSpacing="4">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="38" />
                                                                                    <ColumnDefinition Width="*" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <Border
                                                                                    x:Name="UpcomingBannerPortraitBacking"
                                                                                    Width="38"
                                                                                    Height="38"
                                                                                    Background="{ThemeResource QuietSurfaceBrush}"
                                                                                    BorderBrush="{ThemeResource IrisBrush}"
                                                                                    BorderThickness="2"
                                                                                    CornerRadius="19"
                                                                                    IsHitTestVisible="False"
                                                                                    Visibility="{Binding PrimaryVisibility}" />
                                                                                <Border
                                                                                    x:Name="UpcomingBannerPortrait"
                                                                                    Width="34"
                                                                                    Height="34"
                                                                                    CornerRadius="17"
                                                                                    IsHitTestVisible="False"
                                                                                    AutomationProperties.Name="{Binding Name}"
                                                                                    Visibility="{Binding PrimaryVisibility}">
                                                                                    <Image
                                                                                        Source="{Binding PortraitSource}"
                                                                                        Stretch="UniformToFill" />
                                                                                </Border>
                                                                                <TextBlock
                                                                                    x:Name="UpcomingBannerNameLabel"
                                                                                    Grid.Column="1"
                                                                                    Margin="2,0"
                                                                                    VerticalAlignment="Center"
                                                                                    FontFamily="{StaticResource NyxBodyFont}"
                                                                                    FontSize="15"
                                                                                    Foreground="{ThemeResource MoonBrush}"
                                                                                    IsHitTestVisible="False"
                                                                                    Text="{Binding Name}"
                                                                                    TextWrapping="Wrap"
                                                                                    ToolTipService.ToolTip="{Binding Name}"
                                                                                    Visibility="{Binding PrimaryVisibility}" />
                                                                                <Button
                                                                                    x:Name="UpcomingBannerNameButton"
                                                                                    Grid.Column="1"
                                                                                    Margin="0"
                                                                                    Padding="0"
                                                                                    HorizontalAlignment="Stretch"
                                                                                    VerticalAlignment="Stretch"
                                                                                    AutomationProperties.Name="{Binding AccessibilityName}"
                                                                                    Background="Transparent"
                                                                                    BorderThickness="0"
                                                                                    Click="CharacterLink_Click"
                                                                                    CommandParameter="{Binding CharacterUrl}"
                                                                                    IsEnabled="{Binding CanOpen}"
                                                                                    Style="{StaticResource NyxCodeCopyButtonStyle}"
                                                                                    Tag="{Binding Name}"
                                                                                    ToolTipService.ToolTip="{Binding Name}"
                                                                                    Visibility="{Binding PrimaryVisibility}" />
                                                                                <ItemsControl
                                                                                    x:Name="UpcomingBannerOverflowPortraits"
                                                                                    Grid.ColumnSpan="2"
                                                                                    HorizontalAlignment="Left"
                                                                                    ItemsSource="{Binding OverflowPortraits}"
                                                                                    Visibility="{Binding OverflowVisibility}">
                                                                                    <ItemsControl.ItemsPanel>
                                                                                        <ItemsPanelTemplate>
                                                                                            <StackPanel Orientation="Horizontal" Spacing="5" />
                                                                                        </ItemsPanelTemplate>
                                                                                    </ItemsControl.ItemsPanel>
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                            <Border
                                                                                                Width="28"
                                                                                                Height="28"
                                                                                                Background="{ThemeResource QuietSurfaceBrush}"
                                                                                                BorderBrush="{ThemeResource IrisBrush}"
                                                                                                BorderThickness="2"
                                                                                                CornerRadius="14"
                                                                                                AutomationProperties.Name="{Binding Name}"
                                                                                                ToolTipService.ToolTip="{Binding Name}">
                                                                                                <Image
                                                                                                    Source="{Binding PortraitSource}"
                                                                                                    Stretch="UniformToFill" />
                                                                                            </Border>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl
                                    x:Name="BannerCollectionList"
                                    Margin="0,2,0,0"
                                    AutomationProperties.Name="Banner character collection"
                                    ItemsSource="{x:Bind BannerCollectionRows, Mode=OneWay}"
                                    Visibility="Collapsed">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsWrapGrid Orientation="Vertical" MaximumRowsOrColumns="5" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="196" Margin="0,0,8,8" ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="46" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border
                                                    Width="44"
                                                    Height="44"
                                                    Background="{ThemeResource QuietSurfaceBrush}"
                                                    BorderBrush="{ThemeResource HairlineBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="22">
                                                    <Image
                                                        Width="44"
                                                        Height="44"
                                                        Source="{Binding PortraitSource}"
                                                        Stretch="UniformToFill" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                    <Button
                                                        Margin="0"
                                                        Padding="0"
                                                        HorizontalAlignment="Left"
                                                        AutomationProperties.Name="{Binding AccessibilityName}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Click="CharacterLink_Click"
                                                        CommandParameter="{Binding CharacterUrl}"
                                                        IsEnabled="{Binding CanOpen}"
                                                        Tag="{Binding Name}">
                                                        <TextBlock
                                                            FontFamily="{StaticResource NyxBodyFont}"
                                                            FontSize="15"
                                                            Foreground="{ThemeResource MoonBrush}"
                                                            Text="{Binding Name}" />
                                                    </Button>
                                                    <TextBlock
                                                        FontFamily="{StaticResource NyxDataFont}"
                                                        FontSize="10"
                                                        Foreground="{ThemeResource MistBrush}"
                                                        Text="{Binding Availability}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel
                                    x:Name="BannerCategoryTabs"
                                    Margin="0,2,0,0"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    Visibility="Collapsed">
                                    <Button
                                        x:Name="CurrentBannerCategoryButton"
                                        Height="30"
                                        MinHeight="30"
                                        Padding="12,0"
                                        AutomationProperties.Name="Show current banners"
                                        Click="BannerCategoryButton_Click"
                                        CommandParameter="current"
                                        Content="CURRENT"
                                        Style="{StaticResource NyxOfficialLauncherStyle}" />
                                    <Button
                                        x:Name="UpcomingBannerCategoryButton"
                                        Height="30"
                                        MinHeight="30"
                                        Padding="12,0"
                                        AutomationProperties.Name="Show upcoming banners"
                                        Click="BannerCategoryButton_Click"
                                        CommandParameter="upcoming"
                                        Content="UPCOMING"
                                        Style="{StaticResource NyxOfficialLauncherStyle}" />
                                    <Button
                                        x:Name="CollabBannerCategoryButton"
                                        Height="30"
                                        MinHeight="30"
                                        Padding="12,0"
                                        AutomationProperties.Name="Show Fate collaboration banners"
                                        Click="BannerCategoryButton_Click"
                                        CommandParameter="collab"
                                        Content="FATE COLLAB"
                                        Style="{StaticResource NyxOfficialLauncherStyle}" />
                                </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>

            <Border
                x:Name="LowerActionRegion"
                Grid.RowSpan="2"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                Height="280"
                Margin="0"
                Padding="26,10"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                Background="Transparent"
                BorderThickness="0"
                CornerRadius="0">
                <Grid x:Name="LowerActionGrid" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="405" />
                    </Grid.ColumnDefinitions>

                    <Border
                        x:Name="CombinedStatusPanel"
                        Grid.Column="0"
                        Margin="0,8,0,0"
                        VerticalAlignment="Top"
                        Padding="16,10,12,10"
                        Background="{ThemeResource LauncherInfoSurfaceBrush}"
                        BorderBrush="{ThemeResource DeckBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <Grid x:Name="CombinedStatusGrid" ColumnSpacing="22" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="1" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="CombinedBannerColumn" Width="220" />
                            </Grid.ColumnDefinitions>
                            <Grid
                                x:Name="CodesHeaderGrid"
                                Grid.Row="0"
                                Grid.Column="0"
                                ColumnSpacing="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="PremiumCodesLabel"
