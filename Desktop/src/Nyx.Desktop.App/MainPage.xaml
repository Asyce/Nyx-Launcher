                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="AchievementSourcePrefix"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource NyxDataFont}"
                                    FontSize="8"
                                    Foreground="{ThemeResource MistBrush}"
                                    Text="Export from:" />
                                <RadioButton
                                    x:Name="GameAchievementSourceRadio"
                                    Grid.Column="1"
                                    MinHeight="28"
                                    Padding="4,0"
                                    VerticalContentAlignment="Center"
                                    GroupName="AchievementSource"
                                    Click="StableAchievementSourceRadio_Click"
                                    Content="Game"
                                    FontFamily="{StaticResource NyxDataFont}"
                                    FontSize="8"
                                    Tag="game" />
                                <RadioButton
                                    x:Name="HoyoLabAchievementSourceRadio"
                                    Grid.Column="2"
                                    MinHeight="28"
                                    Padding="4,0"
                                    VerticalContentAlignment="Center"
                                    GroupName="AchievementSource"
                                    Click="StableAchievementSourceRadio_Click"
                                    Content="HoYoLAB"
                                    FontFamily="{StaticResource NyxDataFont}"
                                    FontSize="8"
                                    Tag="hoyolab" />
                            </Grid>
                        </Grid>

                        <TextBlock
                            x:Name="StableExportStatusText"
                            Grid.Row="3"
                            Margin="12,0"
                            AutomationProperties.LiveSetting="Polite"
                            FontFamily="{StaticResource NyxBodyFont}"
                            FontSize="9"
                            Foreground="{ThemeResource MistBrush}"
                            MaxLines="2"
                            Text=""
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                        </Grid>
                    </Grid>

                    <Grid
                        x:Name="LaunchStack"
                        Grid.Column="2"
                        Width="405"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Bottom"
                        RowSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Button
                            x:Name="PrimaryGameStatusButton"
                            Grid.Row="0"
                            MinHeight="24"
                            Padding="4,0"
                            Margin="12,6,12,0"
                            HorizontalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            AutomationProperties.Name="Game status"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="PrimaryGameStatusButton_Click"
                            IsTabStop="False"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="HeroDescription"
                            Grid.Row="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            FontFamily="{StaticResource NyxDataFont}"
                            FontSize="11"
                            Foreground="{ThemeResource LavenderBrush}"
                            MaxLines="1"
                            Text="Official files verified."
                            TextWrapping="NoWrap"
                            TextTrimming="CharacterEllipsis"
                            Visibility="Collapsed"
                            AutomationProperties.LiveSetting="Polite" />
                        <Border
                            x:Name="LaunchResourceMetricsPanel"
                            Grid.Row="1"
                            Padding="4,2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{ThemeResource LauncherUiBackdropBrush}"
                            BorderBrush="{ThemeResource DeckBorderBrush}"
                            BorderThickness="1">
                            <Grid
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="24" />
                            </Grid.ColumnDefinitions>
                            <StackPanel
                                x:Name="LaunchPrimaryResourceItem"
                                Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="4"
                                ToolTipService.ToolTip="Current resource">
                                <Image
                                    x:Name="LaunchPrimaryResourceIcon"
                                    Width="28"
                                    Height="28"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Primary account resource"
                                    Stretch="Uniform" />
                                <TextBlock
                                    x:Name="LaunchPrimaryResourceValueText"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource NyxDataFont}"
                                    FontSize="11"
                                    Foreground="{ThemeResource MoonBrush}"
                                    Text="67/300" />
                            </StackPanel>
                            <StackPanel
                                x:Name="LaunchReserveResourceItem"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="4"
                                ToolTipService.ToolTip="Stored resource">
                                <Image
                                    x:Name="LaunchReserveResourceIcon"
                                    Width="28"
                                    Height="28"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Stored account resource"
                                    Stretch="Uniform" />
                                <TextBlock
                                    x:Name="LaunchReserveResourceValueText"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource NyxDataFont}"
                                    FontSize="11"
                                    Foreground="{ThemeResource MoonBrush}"
                                    Text="86" />
                            </StackPanel>
                            <StackPanel
                                x:Name="LaunchRecoveryResourceItem"
                                Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="4"
                                ToolTipService.ToolTip="Time until full">
                                <FontIcon
                                    x:Name="LaunchRecoveryResourceIcon"
                                    Width="22"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="18"
                                    Foreground="{ThemeResource IrisBrush}"
                                    AutomationProperties.Name="Time until resource is full"
                                    Glyph="&#xE823;" />
                                <TextBlock
                                    x:Name="LaunchRecoveryResourceValueText"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource NyxDataFont}"
                                    FontSize="11"
                                    Foreground="{ThemeResource MoonBrush}"
                                    Text="23H 12M" />
                            </StackPanel>
                            <StackPanel
                                x:Name="LaunchDailyResourceItem"
                                Grid.Column="3"
                                Orientation="Horizontal"
                                Spacing="4"
                                ToolTipService.ToolTip="Daily activity">
                                <FontIcon
                                    x:Name="LaunchDailyResourceIcon"
                                    Width="22"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="18"
                                    Foreground="{ThemeResource IrisBrush}"
                                    AutomationProperties.Name="Daily activity"
                                    Glyph="&#xE73E;" />
                                <TextBlock
                                    x:Name="LaunchDailyResourceValueText"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource NyxDataFont}"
                                    FontSize="11"
                                    Foreground="{ThemeResource MoonBrush}"
                                    Text="100/100" />
                            </StackPanel>
                            <Button
                                x:Name="LaunchResourceRefreshButton"
                                Grid.Column="4"
                                Width="28"
                                Height="28"
                                MinWidth="28"
                                MinHeight="28"
                                Padding="0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Refresh account resources"
                                Click="WuWaAccountStatusRefreshButton_Click"
                                Content="&#xE72C;"
                                FontFamily="Segoe Fluent Icons"
                                Style="{StaticResource NyxQuietActionStyle}"
                                ToolTipService.ToolTip="Refresh account resources" />
                            </Grid>
                        </Border>
                         <Button
                             x:Name="LaunchButton"
                             Grid.Row="2"
                             Width="381"
                             Margin="12,0,12,0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Launch Genshin Impact"
                            Click="LaunchButton_Click"
                            IsEnabled="False"
                            PointerEntered="LaunchButton_PointerEntered"
                            PointerExited="LaunchButton_PointerExited"
                            Style="{StaticResource NyxLaunchButtonStyle}">
                            <Grid x:Name="LaunchButtonVisual">
                                <Border
                                    x:Name="LaunchOuterGlow"
                                    Margin="1"
                                    BorderBrush="#4DA998ED"
                                    BorderThickness="4"
                                    CornerRadius="11"
                                    Opacity="0.55" />
                                <Border
                                    x:Name="LaunchOuterFrame"
                                    Margin="5"
                                    BorderBrush="#A998ED"
                                    BorderThickness="2"
                                    CornerRadius="9">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FF160F33" Offset="0" />
                                            <GradientStop Color="#FF181338" Offset="0.47" />
                                            <GradientStop Color="#FF241F44" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <Ellipse
                                            x:Name="LaunchNebulaLeft"
                                            Width="182"
                                            Height="100"
                                            Margin="-34,-32,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Fill="#2E8570CC"
                                            Opacity="0.34" />
                                        <Ellipse
                                            x:Name="LaunchNebulaRight"
                                            Width="164"
                                            Height="88"
                                            Margin="0,8,-32,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Fill="#2445436D"
                                            Opacity="0.52" />
                                        <Canvas
                                            x:Name="LaunchStarCanvas"
                                            Width="367"
                                            Height="82"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsHitTestVisible="False">
                                            <Canvas.Clip>
                                                <RectangleGeometry Rect="0,0,367,82" />
                                            </Canvas.Clip>
                                        </Canvas>
                                        <Canvas
                                            Width="367"
                                            Height="82"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsHitTestVisible="False"
                                            Opacity="0.22">
                                            <Line X1="12" Y1="66" X2="108" Y2="21" Stroke="#8570CC" StrokeThickness="1" />
                                            <Line X1="26" Y1="73" X2="143" Y2="28" Stroke="#45436D" StrokeThickness="1" />
                                            <Line X1="264" Y1="14" X2="356" Y2="47" Stroke="#7669B1" StrokeThickness="1" />
                                            <Line X1="289" Y1="8" X2="358" Y2="31" Stroke="#45436D" StrokeThickness="1" />
                                        </Canvas>
                                        <Border
                                            x:Name="LaunchInnerFrame"
                                            Margin="8"
                                            BorderBrush="#8570CC"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Opacity="0.92">
                                            <TextBlock
                                                x:Name="LaunchDetail"
                                                Height="20"
                                                Margin="12,0,12,4"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Bottom"
                                                AutomationProperties.LiveSetting="Polite"
                                                FontFamily="{StaticResource NyxBodyFont}"
                                                FontSize="12"
                                                Foreground="{ThemeResource LaunchActionForegroundBrush}"
                                                MaxLines="1"
                                                Text="Verifying local files"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                        </Border>
                                         <Border
                                             x:Name="LaunchInnerHighlight"
                                            Margin="10"
                                            BorderBrush="#349790C9"
                                             BorderThickness="1"
                                             CornerRadius="5"
                                             Opacity="0.55" />
                                        <TextBlock
                                            x:Name="LaunchTitle"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="Segoe UI Variable Display"
                                            FontSize="36"
                                            FontWeight="Normal"
                                            CharacterSpacing="115"
                                            Foreground="{ThemeResource LaunchActionForegroundBrush}"
                                            Text="CHECKING"
                                            TextTrimming="CharacterEllipsis" />
                                     </Grid>
                                 </Border>
                             </Grid>
                         </Button>
                         <Grid
                             x:Name="LaunchUtilityButtons"
                             Grid.Row="3"
                             Margin="12,0,12,0"
                             HorizontalAlignment="Stretch"
                             ColumnSpacing="8">
                             <Grid.ColumnDefinitions>
                                 <ColumnDefinition Width="*" />
                                 <ColumnDefinition Width="*" />
                             </Grid.ColumnDefinitions>
                             <Button
                                 x:Name="StableOpenUpdaterButton"
                                 Grid.Column="0"
                                 Height="28"
                                 MinHeight="28"
                                 HorizontalAlignment="Stretch"
                                 AutomationProperties.Name="Open the selected game's official launcher"
                                 Click="OpenUpdaterButton_Click"
                                 Content="Official Launcher"
                                 IsEnabled="False"
                                 Style="{StaticResource NyxOfficialLauncherStyle}" />
                             <Button
                                 x:Name="StableOpenScreenshotFolderButton"
                                 Grid.Column="1"
                                 Height="28"
                                 MinHeight="28"
                                 HorizontalAlignment="Stretch"
                                 AutomationProperties.Name="Open the selected game's screenshot folder"
                                 Click="OpenScreenshotFolderButton_Click"
                                 Content="Screenshots"
                                 IsEnabled="False"
                                 Style="{StaticResource NyxOfficialLauncherStyle}" />
                         </Grid>
                    </Grid>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Page>
