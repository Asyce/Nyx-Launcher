<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Nyx_Desktop_App.PublisherSessionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#F40B0815">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="42" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarDrag" Padding="18,0,12,0" Background="#CC120D22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Width="34" Height="34" Source="ms-appx:///Assets/Iris/nyx-logo.png" Stretch="Uniform" />
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                <TextBlock FontFamily="{StaticResource NyxDisplayFont}" FontSize="15" FontWeight="SemiBold" Foreground="#FFF8F5FF" Text="NYX" />
                <TextBlock x:Name="WindowHeading" FontFamily="{StaticResource NyxBodyFont}" FontSize="14" Foreground="#FFC9C1D9" Text="Publisher connection" />
            </StackPanel>
        </Grid>

        <WebView2 x:Name="Browser" Grid.Row="1" DefaultBackgroundColor="#0B0815" />

        <Grid Grid.Row="2" Padding="16,0" Background="#E8120D22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="StatusText"
                VerticalAlignment="Center"
                FontFamily="{StaticResource NyxBodyFont}"
                FontSize="12"
                Foreground="#FFC9C1D9" />
            <Button
                x:Name="RetryButton"
                Grid.Column="1"
                MinWidth="112"
                Height="30"
                Margin="0,0,8,0"
                AutomationProperties.Name="Retry the official publisher sign-in page"
                Click="RetryButton_Click"
                Content="RETRY"
                Style="{StaticResource NyxQuietActionStyle}"
                Visibility="Collapsed" />
            <Button
                x:Name="DoneButton"
                Grid.Column="2"
                MinWidth="112"
                Height="30"
                Click="DoneButton_Click"
                Content="DONE"
                Style="{StaticResource NyxOfficialLauncherStyle}" />
        </Grid>
    </Grid>
</Window>
