<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="NyxVoidColor">#08060F</Color>
    <Color x:Key="NyxNebulaColor">#120D1D</Color>
    <Color x:Key="NyxMoonColor">#F5F2FF</Color>
    <Color x:Key="NyxMistColor">#AAA4B8</Color>
    <Color x:Key="NyxIrisColor">#B8A6FF</Color>

    <SolidColorBrush x:Key="VoidBrush" Color="{StaticResource NyxVoidColor}" />
    <SolidColorBrush x:Key="DeepBrush" Color="{StaticResource NyxVoidColor}" />
    <SolidColorBrush x:Key="NebulaBrush" Color="{StaticResource NyxNebulaColor}" />
    <SolidColorBrush x:Key="MoonBrush" Color="{StaticResource NyxMoonColor}" />
    <SolidColorBrush x:Key="MistBrush" Color="{StaticResource NyxMistColor}" />
    <SolidColorBrush x:Key="IrisBrush" Color="{StaticResource NyxIrisColor}" />
    <SolidColorBrush x:Key="UltravioletBrush" Color="{StaticResource NyxIrisColor}" />
    <SolidColorBrush x:Key="LavenderBrush" Color="#DED6FF" />
    <SolidColorBrush x:Key="HairlineBrush" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="QuietSurfaceBrush" Color="#CC181126" />
    <SolidColorBrush x:Key="RailSurfaceBrush" Color="#B8080612" />
    <SolidColorBrush x:Key="GlassDeckBrush" Color="#E0161127" />
    <SolidColorBrush x:Key="SettingsSurfaceBrush" Color="#FF141024" />
    <SolidColorBrush x:Key="ReadingSurfaceBrush" Color="#C0100C1C" />
    <SolidColorBrush x:Key="LauncherUiBackdropBrush" Color="#C8100C1C" />
    <SolidColorBrush x:Key="LauncherInfoSurfaceBrush" Color="#BC100C1C" />
    <SolidColorBrush x:Key="DeckBorderBrush" Color="#60B8A6FF" />
    <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource NyxIrisColor}" />
    <SolidColorBrush x:Key="FocusPrimaryBrush" Color="{StaticResource NyxIrisColor}" />
    <SolidColorBrush x:Key="FocusSecondaryBrush" Color="{StaticResource NyxMoonColor}" />
    <SolidColorBrush x:Key="PrimaryActionBackgroundBrush" Color="{StaticResource NyxMoonColor}" />
    <SolidColorBrush x:Key="PrimaryActionForegroundBrush" Color="{StaticResource NyxVoidColor}" />
    <SolidColorBrush x:Key="LaunchActionBackgroundBrush" Color="#E5160F34" />
    <SolidColorBrush x:Key="LaunchActionForegroundBrush" Color="#F7F3FF" />
    <SolidColorBrush x:Key="LaunchActionBorderBrush" Color="#C5A88CFF" />
    <SolidColorBrush x:Key="QuietActionForegroundBrush" Color="#DED6FF" />
    <SolidColorBrush x:Key="HighContrastBackdropBrush" Color="{StaticResource NyxVoidColor}" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#B8A6FF" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#D0C5FF" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#8D7CC9" />
    <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#4DB8A6FF" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#D8CFFF" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#B8A6FF" />
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#9487C4" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#08060F" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#A608060F" />
    <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Color="#6608060F" />
    <x:Double x:Key="DecorativeArtOpacity">1</x:Double>
    <x:Double x:Key="HighContrastBackdropOpacity">0</x:Double>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="VoidBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="DeepBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="NebulaBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="MoonBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="MistBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="IrisBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="UltravioletBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="LavenderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="HairlineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="QuietSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="RailSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GlassDeckBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SettingsSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ReadingSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="LauncherUiBackdropBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="LauncherInfoSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="DeckBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SelectionBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="FocusPrimaryBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="FocusSecondaryBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="PrimaryActionBackgroundBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="PrimaryActionForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="LaunchActionBackgroundBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="LaunchActionForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="LaunchActionBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="QuietActionForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="HighContrastBackdropBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <x:Double x:Key="DecorativeArtOpacity">0</x:Double>
            <x:Double x:Key="HighContrastBackdropOpacity">1</x:Double>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
