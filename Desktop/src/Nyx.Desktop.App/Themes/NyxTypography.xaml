<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="NyxLauncherFont">ms-appx:///Assets/Fonts/Manrope-Variable.ttf#Manrope</FontFamily>
    <FontFamily x:Key="NyxDisplayFont">ms-appx:///Assets/Fonts/Manrope-Variable.ttf#Manrope</FontFamily>
    <FontFamily x:Key="NyxBodyFont">ms-appx:///Assets/Fonts/Manrope-Variable.ttf#Manrope</FontFamily>
    <FontFamily x:Key="NyxDataFont">ms-appx:///Assets/Fonts/Manrope-Variable.ttf#Manrope</FontFamily>
    <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/Manrope-Variable.ttf#Manrope</FontFamily>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NyxLauncherFont}" />
    </Style>

    <Style x:Key="NyxEyebrowTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NyxBodyFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="180" />
        <Setter Property="Foreground" Value="{ThemeResource MistBrush}" />
    </Style>

    <Style x:Key="NyxDisplayTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NyxDisplayFont}" />
        <Setter Property="FontSize" Value="56" />
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="CharacterSpacing" Value="-12" />
        <Setter Property="Foreground" Value="{ThemeResource MoonBrush}" />
    </Style>

    <Style x:Key="NyxBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NyxBodyFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource MistBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="NyxDataTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NyxDataFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource MistBrush}" />
    </Style>
</ResourceDictionary>
