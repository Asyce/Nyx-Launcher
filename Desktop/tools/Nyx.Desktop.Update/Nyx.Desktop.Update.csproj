<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Nyx.Desktop.Update</AssemblyName>
    <RootNamespace>Nyx.Desktop.Update</RootNamespace>
    <PublishTrimmed>true</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\Nyx.Desktop.Core\State\NyxUserDataPaths.cs" Link="Shared\NyxUserDataPaths.cs" />
    <Compile Include="..\..\src\Nyx.Desktop.Core\Updating\StableUpdatePolicy.cs" Link="Shared\StableUpdatePolicy.cs" />
    <Compile Include="..\..\src\Nyx.Desktop.Core\Updating\UpdateManifest.cs" Link="Shared\UpdateManifest.cs" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Nyx.Desktop.Core.Updating" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Nyx.Desktop.Packaging.Tests" />
  </ItemGroup>
</Project>
